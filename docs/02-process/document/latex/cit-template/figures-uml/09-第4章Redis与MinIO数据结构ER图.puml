@startuml
' Conceptual data model for MinIO and Redis.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "SimSun"
skinparam linetype ortho
skinparam ArrowThickness 1.1
skinparam ArrowColor #475569
hide circle

title CulCloud MinIO 与 Redis 概念数据模型图

entity "文件对象\nMinIO Object" as FileObject {
  * object_name
  --
  filename
  size
  content_type
  last_modified
}

entity "目录标记\nFolder Marker" as FolderMarker {
  * prefix/.keep
  --
  path_prefix
}

entity "预览缓存\nPreview Object" as PreviewObject {
  * preview_path
  --
  source_object
  preview_type
}

entity "转换产物\nConversion Object" as ConversionObject {
  * result_path
  --
  task_id
  output_type
}

entity "任务记录\nRedis Task" as TaskRecord {
  * task_id
  --
  kind
  status
  result_url
  error
}

entity "操作日志\nRedis Event" as EventLog {
  * event_time
  --
  type
  action
  file_name
  task_id
}

FolderMarker ||--o{ FileObject : 组织
FileObject ||--o{ PreviewObject : 生成
FileObject ||--o{ ConversionObject : 转换
TaskRecord ||--o| ConversionObject : 输出
TaskRecord ||--o{ EventLog : 记录
FileObject ||--o{ EventLog : 触发

legend bottom
  本图为概念模型，不展开 Redis 具体 key 与索引集合
  MinIO 目录由对象名前缀和 .keep 空对象共同表达
endlegend

@enduml
