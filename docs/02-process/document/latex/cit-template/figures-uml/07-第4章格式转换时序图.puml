@startuml
' Conversion sequence diagram, reduced to the core asynchronous path.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "SimSun"
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ArrowThickness 1.2
skinparam ArrowColor #475569

title CulCloud 格式转换任务时序图

actor "用户" as User
participant "转换中心" as FE
participant "FastAPI 转换接口" as API
database "Redis 任务状态" as Redis
participant "后台转换任务" as Worker
participant "转换引擎" as Engine
database "MinIO" as MinIO

User -> FE : 选择文件与目标格式
FE -> API : 提交转换请求
API -> API : 校验白名单与参数
API -> Redis : 创建任务\nqueued
API --> FE : 返回 task_id

API -> Worker : 启动后台任务
Worker -> Redis : 更新为 processing
Worker -> MinIO : 读取源文件
Worker -> Engine : 执行格式转换
Engine --> Worker : 返回结果文件
Worker -> MinIO : 写入转换产物
Worker -> Redis : 更新为 completed\n记录 result_url

loop 短轮询
  FE -> API : 查询任务状态
  API -> Redis : 读取任务
  API --> FE : 状态 / 结果 / 错误
end

alt 转换失败
  Worker -> Redis : 更新为 failed\n记录 error
  FE --> User : 展示失败原因
else 转换完成
  FE --> User : 展示下载入口
end

@enduml
