  "decisions": [
    {
      "id": "S11-ADR-01",
      "topic": "整体达标优先",
      "decision": "以 7 章总字数与章节均衡为验收目标，不允许单章过量文本掩盖其他章节空心。",
      "reason": "课程报告评分关注整体结构完整性；单章堆字会导致模板章节失衡。"
    },
    {
      "id": "S11-ADR-02",
      "topic": "多智能体写作模式",
      "decision": "主智能体负责任务分发和质量验收，子智能体只负责指定章节的结构化 LaTeX patch。",
      "reason": "分章扩写可以控制上下文污染，主体验收可以统一术语、事实和门禁。"
    },
    {
      "id": "S11-ADR-03",
      "topic": "计数器强制使用",
      "decision": "所有扩写回合必须运行 latex_chapter_audit.py，以计数器而非模型感觉判断字数。",
      "reason": "模型无法稳定控制输出长度，必须依赖计数器避免正文少于图表。"
    }
  ],
