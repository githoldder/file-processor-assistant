@startuml
' Detailed design component diagram, simplified to four feature groups.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam componentStyle rectangle
skinparam defaultFontName "SimSun"
skinparam linetype ortho
skinparam ArrowThickness 1.2
skinparam ArrowColor #475569
left to right direction

title CulCloud 第5章核心功能详细设计组件图

package "文件管理" #FAF5FF {
  [MyFiles] as MyFiles
  [文件/目录接口] as FileFolderAPI
}

package "预览与转换" #FFF7ED {
  [PreviewFrame] as PreviewFrame
  [ConvertCenter] as ConvertCenter
  [预览/转换接口] as ConvertAPI
  [DocumentConverter] as Converter
}

package "PDF 编辑室" #EFF6FF {
  [PDFStudio] as PDFStudio
  [页面提取与导出接口] as PdfAPI
}

package "可观察性" #F8FAFC {
  [Dashboard / TaskMonitor] as UserObserve
  [Analytics / SystemStatus] as AdminObserve
  [任务与日志服务] as RuntimeService
}

database "MinIO\n文件/预览/产物" as MinIO #F0FDFA
database "Redis\n任务/日志/健康" as Redis #F0FDFA
[Gotenberg\nOffice/PDF 转换] as Gotenberg #F0FDFA

MyFiles --> FileFolderAPI
MyFiles --> PreviewFrame
FileFolderAPI --> MinIO

PreviewFrame --> ConvertAPI : 读取预览
ConvertCenter --> ConvertAPI : 提交转换
ConvertAPI --> Converter
Converter --> Gotenberg
Converter --> MinIO
ConvertAPI --> RuntimeService

PDFStudio --> PdfAPI
PdfAPI --> Converter
PdfAPI --> RuntimeService

UserObserve --> RuntimeService
AdminObserve --> RuntimeService
RuntimeService --> Redis

legend bottom
  本图表达详细设计中的核心组件协作
  接口方法、状态字段和异常分支在正文与测试表中说明
endlegend

@enduml
