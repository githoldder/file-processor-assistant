@startuml
' Management cockpit data pipeline diagram.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam componentStyle rectangle
skinparam defaultFontName "SimSun"
skinparam linetype ortho
skinparam ArrowThickness 1.2
skinparam ArrowColor #475569
left to right direction

title CulCloud 管理驾驶舱数据管线图

actor "管理员" as Admin

package "实时运行口径" #FAF5FF {
  [文件统计\n/files] as FilesAPI
  [任务统计\n/tasks] as TasksAPI
  [操作日志\n/logs] as LogsAPI
  [服务健康\n/system] as HealthAPI
}

package "在线状态存储" #F0FDFA {
  database "MinIO\n文件对象" as MinIO
  database "Redis\n任务/日志/健康" as Redis
}

package "历史分析样本" #EFF6FF {
  folder "data/spark-output" as SparkOutput
  [Flask Analytics] as Flask
}

package "前端管理驾驶舱" #FFF7ED {
  [实时运行视图\n第一屏] as RuntimeView
  [历史分析视图\n第二/三屏] as HistoryView
  [图表组件] as Chart
}

Admin --> RuntimeView
Admin --> HistoryView

RuntimeView --> FilesAPI
RuntimeView --> TasksAPI
RuntimeView --> LogsAPI
RuntimeView --> HealthAPI
RuntimeView --> Chart

FilesAPI --> MinIO
TasksAPI --> Redis
LogsAPI --> Redis
HealthAPI --> Redis

HistoryView --> Flask
Flask --> SparkOutput
HistoryView --> Chart

legend bottom
  第一屏使用 FastAPI 实时接口，随业务操作增量变化
  第二/三屏使用 Spark 输出的历史分析样本，不与实时数值混用
endlegend

@enduml
