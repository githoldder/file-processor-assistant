# ─── OS metadata ───────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─── Local secrets and machine-specific env files ──────────
.env
.env.*
!.env.example
!.env.demo.example
!.env.hadoop.example
file-cloud-frontend/.env
file-cloud-frontend/.env.*
!file-cloud-frontend/.env.example

# ─── Python runtime/cache ─────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/
*.egg-info/

# ─── Node/Vite runtime/cache ──────────────────────────────
node_modules/
file-cloud-frontend/node_modules/
tests/e2e/node_modules/
file-cloud-frontend/dist/
file-cloud-frontend/.vite/

# ─── Test and generated reports ───────────────────────────
tests/e2e/playwright-report/
tests/e2e/test-results/
logs/
*.log

# ─── Build outputs ────────────────────────────────────────
docker/hadoop-mapreduce-lab/target/
data/spark-output/
target/

