@startuml
' File upload and preview activity diagram with swimlanes.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName "SimSun"
skinparam ArrowThickness 1.2
skinparam ArrowColor #475569

title CulCloud 文件上传、整理与预览活动图

start

partition "用户端" #FAF5FF {
  :选择文件或拖拽上传;
  :携带当前目录前缀提交;
}

partition "FastAPI 文件接口" #FFF7ED {
  :校验路径与文件名;
  if (路径合法?) then (是)
    :生成对象名称;
  else (否)
    :返回错误信息;
    stop
  endif
}

partition "MinIO 与日志" #F0FDFA {
  :写入文件对象;
  :记录上传事件;
}

partition "用户端" #FAF5FF {
  :刷新文件列表;
  if (需要预览?) then (是)
    :打开预览入口;
  else (否)
    stop
  endif
}

partition "FastAPI 预览接口" #FFF7ED {
  :识别文件类型;
  if (浏览器可直接展示?) then (是)
    :返回原始内容或访问地址;
  else (否)
    :生成预览缓存;
  endif
}

partition "用户端" #FAF5FF {
  :按预览类型渲染内容;
}

stop

legend bottom
  菱形：条件判断；矩形活动：处理步骤
  预览缓存仅用于 Office 等需转换的文件
endlegend

@enduml
