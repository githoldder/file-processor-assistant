# Docker Hub image used for the Hadoop / MapReduce lab.
#
# The Docker Hub repository must be the full repository name without the tag.
# Example:
# REMOTE_IMAGE=chaoliu123/myubuntu
#
# If Docker Hub uses another repository name, change only REMOTE_IMAGE.
DOCKERHUB_USER=chaoliu123
REMOTE_IMAGE=chaoliu123/myubuntu
REMOTE_TAG=hadoop-mapreduce-lab-topn

# Local alias used by project scripts and docker-compose.demo.yml.
LOCAL_IMAGE=myubuntu:hadoop-mapreduce-lab-topn
HADOOP_CONTAINER=hadoop-mapreduce-lab
