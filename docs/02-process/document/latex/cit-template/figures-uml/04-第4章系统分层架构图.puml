@startuml
' CulCloud layered architecture diagram.
' Style target: layer bands, few nodes, few crossing lines, report-friendly colors.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName "SimSun"
skinparam defaultTextAlignment center
skinparam ArrowThickness 2
skinparam ArrowColor #64748B
skinparam PackageBorderThickness 2
skinparam ComponentBorderThickness 2
skinparam ComponentFontSize 13
skinparam PackageFontSize 16
skinparam PackageFontStyle bold
skinparam linetype ortho
left to right direction

title CulCloud 云端资料处理平台系统分层架构图

rectangle "用户端与管理端\nReact + Vite + TypeScript" as L1 #FAF5FF;line:purple {
  rectangle "用户端\n上传 / 预览 / 转换 / PDF" as UserUI #FFFFFF;line:purple
  rectangle "管理端\n任务 / 日志 / ECharts" as AdminUI #FFFFFF;line:purple
  rectangle "统一请求封装\nAPI Client" as ApiClient #FFFFFF;line:purple
}

rectangle "流量与业务接口层\nFastAPI :8000" as L2 #FFF7ED;line:orange {
  rectangle "文件与目录接口\nfiles / folders" as FileAPI #FFFFFF;line:orange
  rectangle "预览与转换接口\npreview / convert" as ConvertAPI #FFFFFF;line:orange
  rectangle "任务与系统接口\ntasks / logs / system" as OpsAPI #FFFFFF;line:orange
}

rectangle "领域服务层\nPython Services" as L3 #FFF1F2;line:red {
  rectangle "对象存储客户端\nMinIO Client" as MinioSvc #FFFFFF;line:red
  rectangle "转换与预览服务\nGotenberg / PyMuPDF" as ConvertSvc #FFFFFF;line:red
  rectangle "任务与日志服务\nRedis Tracker / Collector" as TaskLogSvc #FFFFFF;line:red
}

rectangle "基础数据层\nDocker Compose" as L4 #F0FDFA;line:teal {
  database "MinIO\n文件与转换产物" as MinIO #FFFFFF;line:teal
  database "Redis\n任务状态与操作日志" as Redis #FFFFFF;line:teal
  rectangle "Gotenberg\nOffice/PDF 转换" as Gotenberg #FFFFFF;line:teal
}

rectangle "离线分析与应用层\nFlask + Spark + ECharts" as L5 #EFF6FF;line:blue {
  folder "Spark 输出\n data/spark-output" as SparkOutput #FFFFFF;line:blue
  rectangle "Flask Analytics :5050\n聚合 JSON API" as Flask #FFFFFF;line:blue
  rectangle "ECharts 看板\n拓扑 / 趋势 / 质量" as ECharts #FFFFFF;line:blue
}

UserUI --> ApiClient : 用户操作
AdminUI --> ApiClient : 管理查询
ApiClient --> FileAPI : /files, /folders
ApiClient --> ConvertAPI : /preview, /convert
ApiClient --> OpsAPI : /tasks, /logs, /system

FileAPI --> MinioSvc : 对象元数据
ConvertAPI --> ConvertSvc : 转换/预览任务
OpsAPI --> TaskLogSvc : 状态与事件

MinioSvc --> MinIO : 读写对象
ConvertSvc --> Gotenberg : 渲染转换
ConvertSvc --> MinIO : 写入产物
TaskLogSvc --> Redis : 持久化状态

Redis -[#64748B,dashed]-> AdminUI : 真实近期事件
SparkOutput --> Flask : 离线聚合读取
Flask --> ECharts : 统计指标
ECharts --> AdminUI : 管理驾驶舱

legend bottom
  <b>线型说明</b>
  实线：业务调用或数据写入
  虚线：可观察数据回流
  第一屏读取 FastAPI 实时接口；历史分析读取 Flask/Spark 离线聚合
endlegend

@enduml
