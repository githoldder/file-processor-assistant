@startuml
' PDF Studio activity diagram, focused on page organization and export.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName "SimSun"
skinparam ArrowThickness 1.2
skinparam ArrowColor #475569

title CulCloud PDF 编辑室页面整理与导出活动图

start

partition "用户端 PDF Studio" #FAF5FF {
  :选择本地或云端 PDF;
}

partition "后端 PDF 接口" #FFF7ED {
  :提取页面预览图;
}

partition "MinIO" #F0FDFA {
  :保存页面预览缓存;
}

partition "用户端 PDF Studio" #FAF5FF {
  :加载页面缩略图;
  repeat
    :排序 / 旋转 / 删除 / 批注;
  repeat while (继续编辑?) is (是)
  :提交导出配置;
}

partition "后端 PDF 接口" #FFF7ED {
  :校验页面配置;
  :重组 PDF 页面;
  if (包含批注?) then (是)
    :映射坐标并写入批注;
  endif
}

partition "MinIO 与任务状态" #F0FDFA {
  :保存导出 PDF;
  :更新任务完成状态;
}

partition "用户端 PDF Studio" #FAF5FF {
  :显示下载入口;
}

stop

@enduml
